# Names only. Put real values in your host's secret manager, never in git or the browser.
DATABASE_URL=            # Postgres connection string, e.g. ...?sslmode=require (Supabase pooler, Neon, etc.)
DATABASE_POOL_MAX=       # optional: max connections per instance (defaults to 1 on Netlify, 5 elsewhere)
RAZORPAY_API_BASE=       # leave empty in production; only for pointing tests at a local stand-in
ADMIN_EMAIL=             # owner login email
ADMIN_PASSWORD_HASH=     # output of: npm run hash-password -- '<12+ char password>'
SESSION_SECRET=          # random string, 32+ characters
RAZORPAY_KEY_ID=         # Razorpay API key id (live or test)
RAZORPAY_KEY_SECRET=     # Razorpay API key secret (server only)
RAZORPAY_WEBHOOK_SECRET= # secret you set when creating the webhook in the Razorpay dashboard
ENABLE_COD=              # set to true ONLY after the owner confirms cash on delivery is offered
CRON_SECRET=             # random string; scheduler sends it as Bearer token to /api/cron/expire-pending
RESEND_API_KEY=          # optional: order emails via Resend
EMAIL_FROM=              # optional: verified sender address
OWNER_EMAIL=             # optional: receives new-order emails
NEXT_PUBLIC_SITE_URL=    # public site URL, e.g. https://your-domain (needed for canonical URLs, sitemap, structured data)
SHOW_DRAFT_NOTICES=   # set to false once copy, review figure and opening hours are approved
ALLOW_INDEXING=       # set to true ONLY at launch (with NEXT_PUBLIC_SITE_URL) to let search engines index the site
