# Throwaway TEST-ONLY values the e2e scripts assume. Never reuse for a real environment.
# Generate the hash with:  npm run hash-password -- 'e2e-admin-password-123'
export DATABASE_URL=postgres://postgres@localhost:5433/lash_e2e
export ADMIN_EMAIL=owner@e2e.test
export ADMIN_PASSWORD_HASH='<output of the hash command above>'
export SESSION_SECRET=e2e-session-secret-0123456789-abcdefghijkl
export RAZORPAY_KEY_ID=rzp_test_e2e
export RAZORPAY_KEY_SECRET=e2e_key_secret_value
export RAZORPAY_WEBHOOK_SECRET=e2e_webhook_secret
export RAZORPAY_API_BASE=http://localhost:4010
export ENABLE_COD=true
export CRON_SECRET=e2e_cron_secret
export NEXT_PUBLIC_SITE_URL=http://localhost:3111
export ALLOW_INDEXING=true
